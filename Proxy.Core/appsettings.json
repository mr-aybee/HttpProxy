{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Titanium.Web.Proxy": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff zzz "
      }
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "Proxy": {
    "Listeners": {
      "Explicit": {
        "Enabled": true,
        "Address": "127.0.0.1",
        "Port": 12000,
        "MaxConcurrentClients": null,
        "GenericCertificateName": "localhost"
      },
      "Transparent": {
        "Enabled": false,
        "Address": "0.0.0.0",
        "Port": 12001,
        "MaxConcurrentClients": null,
        "GenericCertificateName": "localhost"
      },
      "Socks": {
        "Enabled": false,
        "Address": "127.0.0.1",
        "Port": 1080,
        "MaxConcurrentClients": null,
        "GenericCertificateName": "localhost"
      },
      "SetExplicitAsSystemProxy": false
    },
    "Tls": {
      "Mode": "Tunnel",
      "InspectHosts": [],
      "BypassHosts": [],
      "ClientProtocols": "Tls12, Tls13",
      "ServerProtocols": "None",
      "CheckCertificateRevocation": "NoCheck",
      "Certificate": {
        "Source": "Auto",
        "Path": "certificates/orbyn-proxy-root.pfx",
        "Password": "",
        "PasswordEnvironmentVariable": "HTTPPROXY_CERT_PASSWORD",
        "TrustCurrentUser": false,
        "TrustLocalMachine": false,
        "RootCertificateName": "Orbyn Proxy Root Certificate Authority",
        "RootCertificateIssuerName": "Orbyn Technologies",
        "LeafCertificateValidDays": 396,
        "LeafCertificateGraceDays": 2,
        "CacheTimeoutMinutes": 60,
        "SaveGeneratedHostCertificates": false,
        "LeafRsaKeyPairBufferSize": 8
      }
    },
    "Protocols": {
      "EnableHttp2": true,
      "EnableHttp3": false,
      "EnableQpackDynamicTable": false,
      "EnableRfc8441": false,
      "Enable100ContinueBehaviour": false,
      "CompatibilityMode100Continue": false
    },
    "Policy": {
      "BlockedHosts": [],
      "BlockedHostsFile": "BlockedHosts.txt",
      "BlockPrivateNetworkDestinations": false,
      "ViaHeaderPseudonym": "orbyn-proxy"
    },
    "Limits": {
      "MaxDecodedHeaderListBytes": 65536,
      "MaxBufferedBodyBytes": 4194304,
      "MaxWebSocketFramePayloadBytes": 16777216,
      "MaxConcurrentClientConnections": null,
      "ConnectionTimeoutSeconds": 60,
      "ConnectTimeoutSeconds": 20,
      "ClientHeaderTimeoutSeconds": 30,
      "ResponseHeaderTimeoutSeconds": 60,
      "IdleReadTimeoutSeconds": 120,
      "IdleWriteTimeoutSeconds": 120,
      "RequestTimeoutSeconds": 0,
      "ShutdownDrainSeconds": 30
    },
    "Transport": {
      "EnableConnectionPool": true,
      "EnableTcpServerConnectionPrefetch": true,
      "EnableTcpKeepAlive": true,
      "NoDelay": true,
      "ReuseSocket": true,
      "ListenerBacklog": 512,
      "NetworkFailureRetryAttempts": 1,
      "TcpTimeWaitSeconds": 0
    },
    "Upstream": {
      "UseSystemProxy": false,
      "AutoConfigurationUrl": null,
      "Http": {
        "Enabled": false,
        "Type": "Http",
        "Host": "",
        "Port": 0,
        "Username": "",
        "Password": "",
        "PasswordEnvironmentVariable": "HTTPPROXY_UPSTREAM_HTTP_PASSWORD",
        "UseDefaultCredentials": false,
        "BypassLocalhost": true,
        "ProxyDnsRequests": false
      },
      "Https": {
        "Enabled": false,
        "Type": "Http",
        "Host": "",
        "Port": 0,
        "Username": "",
        "Password": "",
        "PasswordEnvironmentVariable": "HTTPPROXY_UPSTREAM_HTTPS_PASSWORD",
        "UseDefaultCredentials": false,
        "BypassLocalhost": true,
        "ProxyDnsRequests": false
      }
    },
    "Authentication": {
      "Enabled": false,
      "Realm": "Orbyn Proxy",
      "Username": "",
      "Password": "",
      "PasswordEnvironmentVariable": "HTTPPROXY_AUTH_PASSWORD"
    },
    "Diagnostics": {
      "LogRequests": true,
      "EnableRequestTimingCapture": false,
      "RequestSampleRate": 1.0
    },
    "Terminal": {
      "RefreshMilliseconds": 250,
      "MaxActivityEntries": 200
    }
  }
}
